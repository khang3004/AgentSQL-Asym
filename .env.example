# API Keys

GEMINI_API_KEY_1=your_gemini_api_key_here
GEMINI_API_KEY_2=your_gemini_api_key_here
GEMINI_API_KEY_3=your_gemini_api_key_here
GEMINI_API_KEY_4=your_gemini_api_key_here

GROQ_API_KEY_1=your_groq_api_key_here
GROQ_API_KEY_2=your_groq_api_key_here
GROQ_API_KEY_3=your_groq_api_key_here
GROQ_API_KEY_4=your_groq_api_key_here

# AgentSQL Model Configuration
GENERATOR_PROVIDER=groq
GENERATOR_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
CRITIC_PROVIDER=google
CRITIC_MODEL=gemini-2.5-flash

# LangSmith Tracing Configuration
# Set to "true" to enable tracing of your agent's execution
LANGCHAIN_TRACING_V2="true"
# Default endpoint for LangSmith API
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
# Your LangSmith API Key (Personal Token)
LANGCHAIN_API_KEY="lsv2_pt_xxxxxxxxxxxxxxxxx"
# Project name for grouping traces in LangSmith dashboard
LANGCHAIN_PROJECT="AgentSQL_BIRD_Eval"

# Database Configurations (Only needed if using MySQL / PostgreSQL)
# Local SQLite does not require these.
MYSQL_HOST=mysql-db
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root_password
MYSQL_DATABASE=BIRD

POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=BIRD
